<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PipelineOrchestration" targetNamespace="https://github.com/mattbang/enterprise-commercial-etl-pipeline/docs" exporter="Codex" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Pipeline">
    <bpmn:participant id="Participant_Pipeline" name="Production Case Study Pipeline" processRef="Process_PipelineOrchestration" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PipelineOrchestration" name="Portfolio-Safe Commercial ETL Orchestration" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_Operator" name="Operator / Scheduler">
        <bpmn:flowNodeRef>StartEvent_WeeklyTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BlockPublication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Failed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Orchestrator" name="Master Orchestrator">
        <bpmn:flowNodeRef>SubProcess_PreFlight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_ETLTransform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_QualityGates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QualityPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ingestion" name="Ingestion Layer">
        <bpmn:flowNodeRef>SubProcess_DownloadSources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DownstreamMatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FieldReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BI" name="Qlik Sense BI">
        <bpmn:flowNodeRef>SubProcess_CloudReload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Verified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Unverified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Unverified</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_WeeklyTrigger" name="Weekly trigger">
      <bpmn:outgoing>Flow_Start_to_PreFlight</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="SubProcess_PreFlight" name="1. Pre-flight config and locks">
      <bpmn:documentation>Validates synthetic public config, resolves paths, checks locks, and confirms runtime prerequisites.</bpmn:documentation>
      <bpmn:incoming>Flow_Start_to_PreFlight</bpmn:incoming>
      <bpmn:outgoing>Flow_PreFlight_to_Ingestion</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_DownloadSources" name="2. Ingest SAP, Salesforce, market forecasts">
      <bpmn:documentation>Stages SAP sales downloads, Salesforce-entered forecast updates, MedTech Europe market reference data, and internally maintained sales and market-share forecasts through the portfolio-safe ingestion boundary.</bpmn:documentation>
      <bpmn:incoming>Flow_PreFlight_to_Ingestion</bpmn:incoming>
      <bpmn:outgoing>Flow_Ingestion_to_Transform</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_ETLTransform" name="3. Transform candidate data">
      <bpmn:documentation>Normalizes source data, applies mapping logic, builds 9-country regional finance scenarios, and stages a candidate dataset.</bpmn:documentation>
      <bpmn:incoming>Flow_Ingestion_to_Transform</bpmn:incoming>
      <bpmn:outgoing>Flow_Transform_to_QA</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_QualityGates" name="4. Blocking quality gates">
      <bpmn:documentation>Runs blocking structural, reconciliation, and freshness checks before publication.</bpmn:documentation>
      <bpmn:incoming>Flow_Transform_to_QA</bpmn:incoming>
      <bpmn:outgoing>Flow_QA_to_Gateway</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_QualityPass" name="Passed?">
      <bpmn:incoming>Flow_QA_to_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_QA_Fail</bpmn:outgoing>
      <bpmn:outgoing>Flow_QA_Pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_BlockPublication" name="Block publish exit 1">
      <bpmn:documentation>Stops publication, preserves the last valid dataset, and returns FAILED.</bpmn:documentation>
      <bpmn:incoming>Flow_QA_Fail</bpmn:incoming>
      <bpmn:incoming>Flow_Match_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Block_to_Failed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Failed" name="FAILED">
      <bpmn:incoming>Flow_Block_to_Failed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_CloudReload" name="5. Reload Qlik Sense and verify">
      <bpmn:documentation>Represents the production Qlik Sense reload and current-run verification export.</bpmn:documentation>
      <bpmn:incoming>Flow_QA_Pass</bpmn:incoming>
      <bpmn:outgoing>Flow_Reload_to_Verified</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_Verified" name="Fresh?">
      <bpmn:incoming>Flow_Reload_to_Verified</bpmn:incoming>
      <bpmn:outgoing>Flow_Verified_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Verified_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Unverified" name="Mark unverified exit 2">
      <bpmn:documentation>Returns UNVERIFIED when downstream proof is absent or stale.</bpmn:documentation>
      <bpmn:incoming>Flow_Verified_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Unverified_to_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Unverified" name="UNVERIFIED">
      <bpmn:incoming>Flow_Unverified_to_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_DownstreamMatch" name="Match?">
      <bpmn:incoming>Flow_Verified_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Match_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Match_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_FieldReview" name="6. Controller review drafts">
      <bpmn:documentation>Generates controller review draft packages when warning-level field checks are present.</bpmn:documentation>
      <bpmn:incoming>Flow_Match_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_to_Success</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Success" name="SUCCESS">
      <bpmn:incoming>Flow_Review_to_Success</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_to_PreFlight" sourceRef="StartEvent_WeeklyTrigger" targetRef="SubProcess_PreFlight" />
    <bpmn:sequenceFlow id="Flow_PreFlight_to_Ingestion" sourceRef="SubProcess_PreFlight" targetRef="SubProcess_DownloadSources" />
    <bpmn:sequenceFlow id="Flow_Ingestion_to_Transform" sourceRef="SubProcess_DownloadSources" targetRef="SubProcess_ETLTransform" />
    <bpmn:sequenceFlow id="Flow_Transform_to_QA" sourceRef="SubProcess_ETLTransform" targetRef="SubProcess_QualityGates" />
    <bpmn:sequenceFlow id="Flow_QA_to_Gateway" sourceRef="SubProcess_QualityGates" targetRef="Gateway_QualityPass" />
    <bpmn:sequenceFlow id="Flow_QA_Fail" name="fail" sourceRef="Gateway_QualityPass" targetRef="Task_BlockPublication" />
    <bpmn:sequenceFlow id="Flow_Block_to_Failed" sourceRef="Task_BlockPublication" targetRef="EndEvent_Failed" />
    <bpmn:sequenceFlow id="Flow_QA_Pass" name="pass" sourceRef="Gateway_QualityPass" targetRef="SubProcess_CloudReload" />
    <bpmn:sequenceFlow id="Flow_Reload_to_Verified" sourceRef="SubProcess_CloudReload" targetRef="Gateway_Verified" />
    <bpmn:sequenceFlow id="Flow_Verified_No" name="stale or missing" sourceRef="Gateway_Verified" targetRef="Task_Unverified" />
    <bpmn:sequenceFlow id="Flow_Unverified_to_End" sourceRef="Task_Unverified" targetRef="EndEvent_Unverified" />
    <bpmn:sequenceFlow id="Flow_Verified_Yes" name="fresh export" sourceRef="Gateway_Verified" targetRef="Gateway_DownstreamMatch" />
    <bpmn:sequenceFlow id="Flow_Match_No" name="mismatch" sourceRef="Gateway_DownstreamMatch" targetRef="Task_BlockPublication" />
    <bpmn:sequenceFlow id="Flow_Match_Yes" name="match" sourceRef="Gateway_DownstreamMatch" targetRef="Task_FieldReview" />
    <bpmn:sequenceFlow id="Flow_Review_to_Success" sourceRef="Task_FieldReview" targetRef="EndEvent_Success" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Pipeline">
    <bpmndi:BPMNPlane id="BPMNPlane_Pipeline" bpmnElement="Collaboration_Pipeline">
      <bpmndi:BPMNShape id="Participant_Pipeline_di" bpmnElement="Participant_Pipeline" isHorizontal="true">
        <dc:Bounds x="80" y="40" width="1830" height="880" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Operator_di" bpmnElement="Lane_Operator" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1750" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Orchestrator_di" bpmnElement="Lane_Orchestrator" isHorizontal="true">
        <dc:Bounds x="120" y="250" width="1750" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Ingestion_di" bpmnElement="Lane_Ingestion" isHorizontal="true">
        <dc:Bounds x="120" y="500" width="1750" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BI_di" bpmnElement="Lane_BI" isHorizontal="true">
        <dc:Bounds x="120" y="670" width="1750" height="210" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_WeeklyTrigger_di" bpmnElement="StartEvent_WeeklyTrigger">
        <dc:Bounds x="205" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_PreFlight_di" bpmnElement="SubProcess_PreFlight" isExpanded="false">
        <dc:Bounds x="320" y="292" width="210" height="96" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_DownloadSources_di" bpmnElement="SubProcess_DownloadSources" isExpanded="false">
        <dc:Bounds x="590" y="540" width="250" height="96" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_ETLTransform_di" bpmnElement="SubProcess_ETLTransform" isExpanded="false">
        <dc:Bounds x="880" y="292" width="210" height="96" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_QualityGates_di" bpmnElement="SubProcess_QualityGates" isExpanded="false">
        <dc:Bounds x="1160" y="292" width="210" height="96" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_QualityPass_di" bpmnElement="Gateway_QualityPass">
        <dc:Bounds x="1460" y="316" width="56" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BlockPublication_di" bpmnElement="Task_BlockPublication">
        <dc:Bounds x="1430" y="128" width="210" height="82" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Failed_di" bpmnElement="EndEvent_Failed">
        <dc:Bounds x="1715" y="151" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_CloudReload_di" bpmnElement="SubProcess_CloudReload" isExpanded="false">
        <dc:Bounds x="1430" y="715" width="220" height="96" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Verified_di" bpmnElement="Gateway_Verified">
        <dc:Bounds x="1185" y="740" width="56" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Unverified_di" bpmnElement="Task_Unverified">
        <dc:Bounds x="895" y="715" width="220" height="82" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Unverified_di" bpmnElement="EndEvent_Unverified">
        <dc:Bounds x="665" y="739" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DownstreamMatch_di" bpmnElement="Gateway_DownstreamMatch">
        <dc:Bounds x="1498" y="542" width="56" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FieldReview_di" bpmnElement="Task_FieldReview">
        <dc:Bounds x="1620" y="540" width="210" height="96" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Success_di" bpmnElement="EndEvent_Success">
        <dc:Bounds x="1715" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_to_PreFlight_di" bpmnElement="Flow_Start_to_PreFlight">
        <di:waypoint x="241" y="158" />
        <di:waypoint x="280" y="158" />
        <di:waypoint x="280" y="340" />
        <di:waypoint x="320" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PreFlight_to_Ingestion_di" bpmnElement="Flow_PreFlight_to_Ingestion">
        <di:waypoint x="530" y="340" />
        <di:waypoint x="565" y="340" />
        <di:waypoint x="565" y="588" />
        <di:waypoint x="590" y="588" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ingestion_to_Transform_di" bpmnElement="Flow_Ingestion_to_Transform">
        <di:waypoint x="840" y="588" />
        <di:waypoint x="846" y="588" />
        <di:waypoint x="846" y="340" />
        <di:waypoint x="880" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Transform_to_QA_di" bpmnElement="Flow_Transform_to_QA">
        <di:waypoint x="1090" y="340" />
        <di:waypoint x="1160" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_QA_to_Gateway_di" bpmnElement="Flow_QA_to_Gateway">
        <di:waypoint x="1370" y="340" />
        <di:waypoint x="1460" y="344" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_QA_Fail_di" bpmnElement="Flow_QA_Fail">
        <di:waypoint x="1488" y="316" />
        <di:waypoint x="1488" y="250" />
        <di:waypoint x="1535" y="250" />
        <di:waypoint x="1535" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Block_to_Failed_di" bpmnElement="Flow_Block_to_Failed">
        <di:waypoint x="1640" y="169" />
        <di:waypoint x="1715" y="169" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_QA_Pass_di" bpmnElement="Flow_QA_Pass">
        <di:waypoint x="1516" y="344" />
        <di:waypoint x="1540" y="344" />
        <di:waypoint x="1540" y="715" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reload_to_Verified_di" bpmnElement="Flow_Reload_to_Verified">
        <di:waypoint x="1430" y="763" />
        <di:waypoint x="1241" y="768" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Verified_No_di" bpmnElement="Flow_Verified_No">
        <di:waypoint x="1185" y="768" />
        <di:waypoint x="1115" y="756" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Unverified_to_End_di" bpmnElement="Flow_Unverified_to_End">
        <di:waypoint x="895" y="756" />
        <di:waypoint x="701" y="757" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Verified_Yes_di" bpmnElement="Flow_Verified_Yes">
        <di:waypoint x="1213" y="740" />
        <di:waypoint x="1213" y="570" />
        <di:waypoint x="1498" y="570" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Match_No_di" bpmnElement="Flow_Match_No">
        <di:waypoint x="1526" y="542" />
        <di:waypoint x="1535" y="542" />
        <di:waypoint x="1535" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Match_Yes_di" bpmnElement="Flow_Match_Yes">
        <di:waypoint x="1554" y="570" />
        <di:waypoint x="1620" y="588" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Review_to_Success_di" bpmnElement="Flow_Review_to_Success">
        <di:waypoint x="1725" y="540" />
        <di:waypoint x="1725" y="388" />
        <di:waypoint x="1733" y="368" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
