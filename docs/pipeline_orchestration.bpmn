<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PipelineOrchestration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_Pipeline">
    <bpmn:participant id="Participant_Pipeline" name="Automated Commercial BI &#38; ETL Pipeline" processRef="Process_PipelineOrchestration" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PipelineOrchestration" name="Pipeline Orchestration Process" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_Operator" name="Operator &#38; Business Controllers">
        <bpmn:flowNodeRef>StartEvent_WeeklyTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CompletedWithActions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CircuitBreaker</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_GovernanceAlerting</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Orchestration" name="Master Python Orchestrator &#38; ETL Engine">
        <bpmn:flowNodeRef>Gateway_SoftAnomalies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendSuccessEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CompletedClean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_PreFlight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_ETLTransform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_Run17Checks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QualityPass</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ingestion" name="Headless Browser Ingestion (Selenium + Auth)">
        <bpmn:flowNodeRef>SubProcess_DownloadSources</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CloudBI" name="Qlik Cloud Analytics Engine">
        <bpmn:flowNodeRef>SubProcess_CloudBIReload</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_WeeklyTrigger" name="Weekly Scheduled Trigger">
      <bpmn:outgoing>Flow_Start_to_PF</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="SubProcess_PreFlight" name="1. Pre-Flight Environment &#38; Lock Validation">
      <bpmn:documentation>Validates OS environment, directory resolution, BI tenant connectivity, and terminates lingering background browser tasks.</bpmn:documentation>
      <bpmn:incoming>Flow_Start_to_PF</bpmn:incoming>
      <bpmn:outgoing>Flow_PF_to_DL</bpmn:outgoing>
      <bpmn:startEvent id="Start_PF" name="Start Pre-Flight">
        <bpmn:outgoing>Flow_PF_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_PF_EnvVars" name="Resolve System Paths &#38; Config Mappings">
        <bpmn:documentation>Expands ${MIDWEST_ROOT} and validates config/mappings.yaml.</bpmn:documentation>
        <bpmn:incoming>Flow_PF_1</bpmn:incoming>
        <bpmn:outgoing>Flow_PF_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_PF_KillZombies" name="Clear OS File Locks &#38; Kill Zombie Processes">
        <bpmn:documentation>Terminates orphan chrome.exe tasks and removes temporary ~$*.xlsx locks.</bpmn:documentation>
        <bpmn:incoming>Flow_PF_2</bpmn:incoming>
        <bpmn:outgoing>Flow_PF_3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_PF_VpnCheck" name="Verify BI Cloud Network Connectivity">
        <bpmn:documentation>Pings Qlik Cloud tenant URL to verify approved authentication route.</bpmn:documentation>
        <bpmn:incoming>Flow_PF_3</bpmn:incoming>
        <bpmn:outgoing>Flow_PF_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_PF" name="Environment Validated">
        <bpmn:incoming>Flow_PF_4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_PF_1" sourceRef="Start_PF" targetRef="Task_PF_EnvVars" />
      <bpmn:sequenceFlow id="Flow_PF_2" sourceRef="Task_PF_EnvVars" targetRef="Task_PF_KillZombies" />
      <bpmn:sequenceFlow id="Flow_PF_3" sourceRef="Task_PF_KillZombies" targetRef="Task_PF_VpnCheck" />
      <bpmn:sequenceFlow id="Flow_PF_4" sourceRef="Task_PF_VpnCheck" targetRef="End_PF" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_ETLTransform" name="3. Vectorized ETL &#38; 3-Scenario Financial Disaggregation">
      <bpmn:documentation>Normalizes multi-country European formats, applies clinical product logic, and synthesizes 3 strategic reporting views.</bpmn:documentation>
      <bpmn:incoming>Flow_DL_to_ETL</bpmn:incoming>
      <bpmn:outgoing>Flow_ETL_to_Reload</bpmn:outgoing>
      <bpmn:startEvent id="Start_ETL" name="Start Transformation">
        <bpmn:outgoing>Flow_ETL_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_ETL_Schema" name="Validate Schemas &#38; Header Structure (Pandera)">
        <bpmn:documentation>Enforces strict column presence, data types, and primary dimension keys.</bpmn:documentation>
        <bpmn:incoming>Flow_ETL_1</bpmn:incoming>
        <bpmn:outgoing>Flow_ETL_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_ETL_Numeric" name="Coerce Heterogeneous European &#38; US Numbers">
        <bpmn:documentation>Executes _smart_parse() regex to convert German comma decimals (1.234,50) and Swiss apostrophes (1'234) into IEEE floats.</bpmn:documentation>
        <bpmn:incoming>Flow_ETL_2</bpmn:incoming>
        <bpmn:outgoing>Flow_ETL_3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_ETL_Territories" name="Remap Country Codes &#38; Consolidate Export Territories">
        <bpmn:documentation>Resolves aliases (UK-&gt;GB, EL-&gt;GR) and maps 13 export territories into standard parent entities.</bpmn:documentation>
        <bpmn:incoming>Flow_ETL_3</bpmn:incoming>
        <bpmn:outgoing>Flow_ETL_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_ETL_ClinicalSplits" name="Execute Clinical Therapy Splits &#38; Group Logic">
        <bpmn:documentation>Calculates single-chamber vs dual-chamber leadless splits and transseptal consolidation rules.</bpmn:documentation>
        <bpmn:incoming>Flow_ETL_4</bpmn:incoming>
        <bpmn:outgoing>Flow_ETL_5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_ETL_Disaggregation" name="Synthesize 3 Commercial Scenarios (Full, Addressable, Weighted)">
        <bpmn:documentation>Disaggregates annual market figures into quarters and dynamically generates 3 distinct reporting scenarios.</bpmn:documentation>
        <bpmn:incoming>Flow_ETL_5</bpmn:incoming>
        <bpmn:outgoing>Flow_ETL_6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_ETL_Conservation" name="Enforce Unit Conservation Law Across Scenarios">
        <bpmn:documentation>Verifies that internal organization units remain mathematically identical across all 3 market views.</bpmn:documentation>
        <bpmn:incoming>Flow_ETL_6</bpmn:incoming>
        <bpmn:outgoing>Flow_ETL_7</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_ETL_Export" name="Export Master CSV &#38; Synchronize to Shared Storage">
        <bpmn:documentation>Writes MarketData_Integrated_Flat.csv and syncs to shared cloud volumes for BI ingestion.</bpmn:documentation>
        <bpmn:incoming>Flow_ETL_7</bpmn:incoming>
        <bpmn:outgoing>Flow_ETL_8</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_ETL" name="Master Datasets Deployed">
        <bpmn:incoming>Flow_ETL_8</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ETL_1" sourceRef="Start_ETL" targetRef="Task_ETL_Schema" />
      <bpmn:sequenceFlow id="Flow_ETL_2" sourceRef="Task_ETL_Schema" targetRef="Task_ETL_Numeric" />
      <bpmn:sequenceFlow id="Flow_ETL_3" sourceRef="Task_ETL_Numeric" targetRef="Task_ETL_Territories" />
      <bpmn:sequenceFlow id="Flow_ETL_4" sourceRef="Task_ETL_Territories" targetRef="Task_ETL_ClinicalSplits" />
      <bpmn:sequenceFlow id="Flow_ETL_5" sourceRef="Task_ETL_ClinicalSplits" targetRef="Task_ETL_Disaggregation" />
      <bpmn:sequenceFlow id="Flow_ETL_6" sourceRef="Task_ETL_Disaggregation" targetRef="Task_ETL_Conservation" />
      <bpmn:sequenceFlow id="Flow_ETL_7" sourceRef="Task_ETL_Conservation" targetRef="Task_ETL_Export" />
      <bpmn:sequenceFlow id="Flow_ETL_8" sourceRef="Task_ETL_Export" targetRef="End_ETL" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_Run17Checks" name="5. 17-Layer Data Quality &#38; Governance Gates">
      <bpmn:documentation>Evaluates the 5-tier defense-in-depth safety net. Halts execution if structural conservation or checksum errors occur.</bpmn:documentation>
      <bpmn:incoming>Flow_Reload_to_QA</bpmn:incoming>
      <bpmn:outgoing>Flow_QA_to_Gateway</bpmn:outgoing>
      <bpmn:startEvent id="Start_QA" name="Start Quality Gates">
        <bpmn:outgoing>Flow_QA_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_QA_Tier1" name="Tier 1: File Existence &#38; Freshness Audit (Check 1)">
        <bpmn:documentation>Asserts all output CSVs and Excels exist with fresh execution timestamps and non-zero bytes.</bpmn:documentation>
        <bpmn:incoming>Flow_QA_1</bpmn:incoming>
        <bpmn:outgoing>Flow_QA_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_QA_Tier2" name="Tier 2: Dimension Completeness &#38; Row Sanity (Checks 2, 8)">
        <bpmn:documentation>Validates null-rate caps on mandatory dimensions (Country, Product) and checks minimum row thresholds.</bpmn:documentation>
        <bpmn:incoming>Flow_QA_2</bpmn:incoming>
        <bpmn:outgoing>Flow_QA_3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_QA_Tier3_Recon" name="Tier 3: Source Reconciliation &#38; Country Preservation (Checks 3-6)">
        <bpmn:documentation>Asserts input units equal output units across all transformations and guarantees 0 lost regions.</bpmn:documentation>
        <bpmn:incoming>Flow_QA_3</bpmn:incoming>
        <bpmn:outgoing>Flow_QA_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_QA_Tier3_Checksum" name="Tier 3: End-to-End Cloud BI Checksum Comparison (Check 9)">
        <bpmn:documentation>Compares Qlik Cloud aggregate units and revenue against Python CSV (diff &lt; 1.00 EUR).</bpmn:documentation>
        <bpmn:incoming>Flow_QA_4</bpmn:incoming>
        <bpmn:outgoing>Flow_QA_5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_QA_Tier4" name="Tier 4: 10x Magnitude Spikes &#38; Velocity Jumps (Checks 7, 10, 14, 15, 17)">
        <bpmn:documentation>Detects number formatting inflations (ratio &gt; 10x), unapproved negative units, and extreme velocity shifts.</bpmn:documentation>
        <bpmn:incoming>Flow_QA_5</bpmn:incoming>
        <bpmn:outgoing>Flow_QA_6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_QA_Tier5" name="Tier 5: Human-Error &#38; Field Heuristics Audit (Checks 11, 12, 13, 16)">
        <bpmn:documentation>Scans forecast submissions for copy-paste duplicates, round numbers (exact 100s), and unchanged baselines.</bpmn:documentation>
        <bpmn:incoming>Flow_QA_6</bpmn:incoming>
        <bpmn:outgoing>Flow_QA_7</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_QA" name="Quality Audit Finished">
        <bpmn:incoming>Flow_QA_7</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_QA_1" sourceRef="Start_QA" targetRef="Task_QA_Tier1" />
      <bpmn:sequenceFlow id="Flow_QA_2" sourceRef="Task_QA_Tier1" targetRef="Task_QA_Tier2" />
      <bpmn:sequenceFlow id="Flow_QA_3" sourceRef="Task_QA_Tier2" targetRef="Task_QA_Tier3_Recon" />
      <bpmn:sequenceFlow id="Flow_QA_4" sourceRef="Task_QA_Tier3_Recon" targetRef="Task_QA_Tier3_Checksum" />
      <bpmn:sequenceFlow id="Flow_QA_5" sourceRef="Task_QA_Tier3_Checksum" targetRef="Task_QA_Tier4" />
      <bpmn:sequenceFlow id="Flow_QA_6" sourceRef="Task_QA_Tier4" targetRef="Task_QA_Tier5" />
      <bpmn:sequenceFlow id="Flow_QA_7" sourceRef="Task_QA_Tier5" targetRef="End_QA" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_QualityPass" name="All Structural Gates Passed?">
      <bpmn:incoming>Flow_QA_to_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Gate_Pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gate_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_CircuitBreaker" name="Trip Circuit Breaker &#38; Dispatch Urgent Error Alert">
      <bpmn:documentation>Halts process; alerts operations lead with diagnostic traceback; blocks publishing corrupted data.</bpmn:documentation>
      <bpmn:incoming>Flow_Gate_Fail</bpmn:incoming>
      <bpmn:outgoing>Flow_Fail_to_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_Start_to_PF" sourceRef="StartEvent_WeeklyTrigger" targetRef="SubProcess_PreFlight" />
    <bpmn:sequenceFlow id="Flow_PF_to_DL" sourceRef="SubProcess_PreFlight" targetRef="SubProcess_DownloadSources" />
    <bpmn:sequenceFlow id="Flow_DL_to_ETL" sourceRef="SubProcess_DownloadSources" targetRef="SubProcess_ETLTransform" />
    <bpmn:sequenceFlow id="Flow_ETL_to_Reload" sourceRef="SubProcess_ETLTransform" targetRef="SubProcess_CloudBIReload" />
    <bpmn:sequenceFlow id="Flow_Reload_to_QA" sourceRef="SubProcess_CloudBIReload" targetRef="SubProcess_Run17Checks" />
    <bpmn:sequenceFlow id="Flow_QA_to_Gateway" sourceRef="SubProcess_Run17Checks" targetRef="Gateway_QualityPass" />
    <bpmn:sequenceFlow id="Flow_Gate_Fail" name="No (Fatal Discrepancy)" sourceRef="Gateway_QualityPass" targetRef="Task_CircuitBreaker" />
    <bpmn:sequenceFlow id="Flow_Fail_to_End" sourceRef="Task_CircuitBreaker" targetRef="EndEvent_Failed" />
    <bpmn:sequenceFlow id="Flow_Gate_Pass" name="Yes (All Passed)" sourceRef="Gateway_QualityPass" targetRef="Gateway_SoftAnomalies" />
    <bpmn:sequenceFlow id="Flow_Anomalies_Yes" name="Yes" sourceRef="Gateway_SoftAnomalies" targetRef="SubProcess_GovernanceAlerting" />
    <bpmn:sequenceFlow id="Flow_Gov_to_End" sourceRef="SubProcess_GovernanceAlerting" targetRef="EndEvent_CompletedWithActions" />
    <bpmn:sequenceFlow id="Flow_Anomalies_No" name="No" sourceRef="Gateway_SoftAnomalies" targetRef="Task_SendSuccessEmail" />
    <bpmn:sequenceFlow id="Flow_Success_to_End" sourceRef="Task_SendSuccessEmail" targetRef="EndEvent_CompletedClean" />
    <bpmn:subProcess id="SubProcess_DownloadSources" name="2. Headless Multi-Source Ingestion (Selenium + Auth)">
      <bpmn:documentation>Autonomous download of 4 raw commercial datasets using a saved authenticated browser profile through browser-based exports.</bpmn:documentation>
      <bpmn:incoming>Flow_PF_to_DL</bpmn:incoming>
      <bpmn:outgoing>Flow_DL_to_ETL</bpmn:outgoing>
      <bpmn:startEvent id="Start_DL" name="Start Ingestion">
        <bpmn:outgoing>Flow_DL_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_DL_InitSession" name="Attach Persistent Browser Profile">
        <bpmn:documentation>Loads encrypted user profile directory to maintain time-limited authenticated browser cookies.</bpmn:documentation>
        <bpmn:incoming>Flow_DL_1</bpmn:incoming>
        <bpmn:outgoing>Flow_DL_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_DL_Crm" name="Ingest CRM Commercial Actuals (Market Tracker)">
        <bpmn:documentation>Navigates CRM export portal, triggers report generation, and captures Market Tracker CRM DL.xlsx.</bpmn:documentation>
        <bpmn:incoming>Flow_DL_2</bpmn:incoming>
        <bpmn:outgoing>Flow_DL_3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_DL_Diagnostics" name="Ingest Quarterly Diagnostics Registry Extracts">
        <bpmn:documentation>Downloads ICM_Market_DL.xlsx and ICM_BIO_DL.xlsx containing therapy unit volumes.</bpmn:documentation>
        <bpmn:incoming>Flow_DL_3</bpmn:incoming>
        <bpmn:outgoing>Flow_DL_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_DL_Forecasts" name="Ingest Corporate Planning Forecast Extracts">
        <bpmn:documentation>Extracts live rolling forecast and synchronizes static quarterly planning baselines.</bpmn:documentation>
        <bpmn:incoming>Flow_DL_4</bpmn:incoming>
        <bpmn:outgoing>Flow_DL_5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_DL_VerifyFiles" name="Poll Filesystem for Download Completion &#38; Size Stability">
        <bpmn:documentation>Monitors OS download directory, validates absence of .crdownload temporary files, and verifies size &gt; 50KB.</bpmn:documentation>
        <bpmn:incoming>Flow_DL_5</bpmn:incoming>
        <bpmn:outgoing>Flow_DL_6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_DL" name="Raw Feeds Staged in data/in/">
        <bpmn:incoming>Flow_DL_6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_DL_1" sourceRef="Start_DL" targetRef="Task_DL_InitSession" />
      <bpmn:sequenceFlow id="Flow_DL_2" sourceRef="Task_DL_InitSession" targetRef="Task_DL_Crm" />
      <bpmn:sequenceFlow id="Flow_DL_3" sourceRef="Task_DL_Crm" targetRef="Task_DL_Diagnostics" />
      <bpmn:sequenceFlow id="Flow_DL_4" sourceRef="Task_DL_Diagnostics" targetRef="Task_DL_Forecasts" />
      <bpmn:sequenceFlow id="Flow_DL_5" sourceRef="Task_DL_Forecasts" targetRef="Task_DL_VerifyFiles" />
      <bpmn:sequenceFlow id="Flow_DL_6" sourceRef="Task_DL_VerifyFiles" targetRef="End_DL" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_CloudBIReload" name="4. Qlik Cloud BI Orchestration &#38; Verification Extraction">
      <bpmn:documentation>Two-way closed-loop handshake: triggers cloud reload, awaits stabilization, and downloads post-reload verification dataset.</bpmn:documentation>
      <bpmn:incoming>Flow_ETL_to_Reload</bpmn:incoming>
      <bpmn:outgoing>Flow_Reload_to_QA</bpmn:outgoing>
      <bpmn:startEvent id="Start_BI" name="Start BI Reload">
        <bpmn:outgoing>Flow_BI_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_BI_Trigger" name="Dispatch Cloud Application Reload Command">
        <bpmn:documentation>Navigates Qlik Cloud Management API/DOM to initiate server-side data model reload.</bpmn:documentation>
        <bpmn:incoming>Flow_BI_1</bpmn:incoming>
        <bpmn:outgoing>Flow_BI_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateCatchEvent id="Timer_BI_Wait" name="Wait 45s for Cloud Processing">
        <bpmn:incoming>Flow_BI_2</bpmn:incoming>
        <bpmn:outgoing>Flow_BI_3</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerDef_BI">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT45S</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="Task_BI_PollStatus" name="Poll for Reload Completion &#38; Model Stabilization">
        <bpmn:documentation>Asserts reload status is SUCCESS; checks server logs for indexing errors.</bpmn:documentation>
        <bpmn:incoming>Flow_BI_3</bpmn:incoming>
        <bpmn:outgoing>Flow_BI_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_BI_ExportVerification" name="Export Summary Verification Dataset from BI Model">
        <bpmn:documentation>Downloads MarketData_Add_Final_Qlik_Verified.csv for end-to-end reconciliation.</bpmn:documentation>
        <bpmn:incoming>Flow_BI_4</bpmn:incoming>
        <bpmn:outgoing>Flow_BI_5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_BI" name="Verification Dataset Staged">
        <bpmn:incoming>Flow_BI_5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_BI_1" sourceRef="Start_BI" targetRef="Task_BI_Trigger" />
      <bpmn:sequenceFlow id="Flow_BI_2" sourceRef="Task_BI_Trigger" targetRef="Timer_BI_Wait" />
      <bpmn:sequenceFlow id="Flow_BI_3" sourceRef="Timer_BI_Wait" targetRef="Task_BI_PollStatus" />
      <bpmn:sequenceFlow id="Flow_BI_4" sourceRef="Task_BI_PollStatus" targetRef="Task_BI_ExportVerification" />
      <bpmn:sequenceFlow id="Flow_BI_5" sourceRef="Task_BI_ExportVerification" targetRef="End_BI" />
    </bpmn:subProcess>
    <bpmn:endEvent id="EndEvent_Failed" name="Pipeline Aborted (Zero Dirty Data Published)">
      <bpmn:incoming>Flow_Fail_to_End</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorDef_Main" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_SoftAnomalies" name="Field Plausibility Warnings Detected?">
      <bpmn:incoming>Flow_Gate_Pass</bpmn:incoming>
      <bpmn:outgoing>Flow_Anomalies_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Anomalies_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_CompletedWithActions" name="Dashboard Live with Active Controller Review Items">
      <bpmn:incoming>Flow_Gov_to_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_SendSuccessEmail" name="Dispatch Clean Executive Summary Email">
      <bpmn:documentation>Sends pass/fail metrics, execution timings, and verification timestamps to leadership.</bpmn:documentation>
      <bpmn:incoming>Flow_Anomalies_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Success_to_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_CompletedClean" name="Pipeline Execution Completed Cleanly">
      <bpmn:incoming>Flow_Success_to_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_GovernanceAlerting" name="6. Automated Field Governance &#38; Controller Distribution">
      <bpmn:documentation>Compiles field warnings and automatically generates pre-filled HTML review drafts for regional financial controllers.</bpmn:documentation>
      <bpmn:incoming>Flow_Anomalies_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Gov_to_End</bpmn:outgoing>
      <bpmn:startEvent id="Start_GA" name="Start Field Governance">
        <bpmn:outgoing>Flow_GA_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_GA_ParseAnomalies" name="Aggregate Country Anomaly Logs (QA_Forecast_Plausibility.csv)">
        <bpmn:documentation>Filters detected copy-paste rows and velocity outliers by country code.</bpmn:documentation>
        <bpmn:incoming>Flow_GA_1</bpmn:incoming>
        <bpmn:outgoing>Flow_GA_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_GA_RenderHtml" name="Render Personalized HTML Controller Email Drafts">
        <bpmn:documentation>Generates controller_drafts/{Country}_data_review.html containing formatted tables of flagged numbers.</bpmn:documentation>
        <bpmn:incoming>Flow_GA_2</bpmn:incoming>
        <bpmn:outgoing>Flow_GA_3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="Task_GA_NotifyControllers" name="Stage Email Drafts &#38; Notify Regional Financial Controllers">
        <bpmn:documentation>Alerts local finance controllers to review and adjust forecasts before board presentation.</bpmn:documentation>
        <bpmn:incoming>Flow_GA_3</bpmn:incoming>
        <bpmn:outgoing>Flow_GA_4</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="End_GA" name="Field Review Dispatched">
        <bpmn:incoming>Flow_GA_4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_GA_1" sourceRef="Start_GA" targetRef="Task_GA_ParseAnomalies" />
      <bpmn:sequenceFlow id="Flow_GA_2" sourceRef="Task_GA_ParseAnomalies" targetRef="Task_GA_RenderHtml" />
      <bpmn:sequenceFlow id="Flow_GA_3" sourceRef="Task_GA_RenderHtml" targetRef="Task_GA_NotifyControllers" />
      <bpmn:sequenceFlow id="Flow_GA_4" sourceRef="Task_GA_NotifyControllers" targetRef="End_GA" />
    </bpmn:subProcess>
  </bpmn:process>
